# Optional OpenSky OAuth credentials.
# The app works without them for public/personal usage, subject to OpenSky limits.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Optional FlightRadar24 API credentials.
# Current FR24 API access requires a subscription; sandbox can be used for development.
FR24_API_TOKEN=
FR24_API_BASE=https://fr24api.flightradar24.com/api

# Optional default airport for the weather panel.
DEFAULT_ICAO=KJFK
